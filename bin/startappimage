#!/usr/bin/env bash
# StartAppImage - install, list, update and remove AppImages with desktop integration.
set -euo pipefail

LEGACY_APP_DIR="$HOME/.local/share/appimages"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/startappimage/config"
cfg_get() { sed -n "s/^$1=//p" "$CONFIG_FILE" 2>/dev/null | head -n1 || true; }
cfg_set() {
  mkdir -p "$(dirname "$CONFIG_FILE")"
  { grep -v "^$1=" "$CONFIG_FILE" 2>/dev/null || true; echo "$1=$2"; } >"$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}
cfg_bool() { # KEY -> true|false; a key nobody set reads as the default for remembering
  local v; v=$(cfg_get "$1")
  if [[ -z $v ]]; then echo "$DEFAULT_REMEMBER"; else [[ $v == false ]] && echo false || echo true; fi
}
# Where new installs go: the folder last chosen with --dir, else the legacy default.
APP_DIR="${STARTAPPIMAGE_DIR:-$(cfg_get INSTALL_DIR)}"
APP_DIR="${APP_DIR:-$LEGACY_APP_DIR}"
DESKTOP_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
BIN_DIR="$HOME/.local/bin"
SVG_ICON_DIR="$HOME/.local/share/icons/hicolor/scalable/apps"
DB_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/startappimage"
PLUGIN_ID="io.github.bmaltais.startappimage"

# With --json (add, set) a failure is one JSON line on stdout, {ok:false, field, error}; field names the setting it was
# about ("source", "dir", ...) or is empty. DIE_FIELD=source die "..." sets it. Otherwise it is a line on stderr.
JSON_RESULT=0
wants_json() { local a; for a in "$@"; do [[ $a != --json ]] || JSON_RESULT=1; done; }
die() {
  if [[ $JSON_RESULT == 1 ]] && command -v jq >/dev/null; then
    jq -nc --arg field "${DIE_FIELD:-}" --arg error "$*" '{ok:false, field:$field, error:$error}'
  else
    echo "startappimage: $*" >&2
  fi
  exit 1
}
# A folder the user typed: "~" expanded, no trailing slash. Installs and moves stay inside the home directory.
expand_dir() { local p=${1/#\~/$HOME}; printf '%s' "${p%/}"; }
inside_home() { [[ $1 == "$HOME"/* ]]; }
# Progress for a person: stdout, or stderr when stdout is reserved for the JSON result.
say() { if [[ $JSON_RESULT == 1 ]]; then echo "$*" >&2; else echo "$*"; fi; }
need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }

usage() {
  cat <<EOF
Usage: startappimage <command> [args]

  add <file|url|github:owner/repo> [name] [--dir <folder>]
                                            Install and integrate an AppImage (--dir picks the
                                            folder and remembers it for next time)
  locations                                 JSON: the default install folder and known folders
  config <name>                             JSON: one app's settings
  set <name> [--name N] [--dir D] [--args A] [--source S] [--hidden true|false]
                                            Change an app's settings
  setup [--launcher B] [--handler B] [--cli B] [--check-hours N]
        [--remember-size B] [--remember-position B] [--bar-icon B]
                                            Desktop integration and how often updates are checked (0 = never)
  folder <path>                             JSON: is this folder allowed (inside your home), and its full path
  window [--size WxH] [--offset X,Y] [--reset] [--setup-size WxH] [--setup-offset X,Y] [--reset-setup]
                                            The manager and settings window's remembered size and place (no option prints them)
  resolve <link|owner/repo>                 JSON: what an update source points at (repo, tag, asset)
  list [--json]                             List installed AppImages
  update [name]                             Update one or all (github-sourced) AppImages
  check [--json]                            Report available updates without installing
  remove <name>                             Uninstall and clean up integration files
  open <file>                               Install window for a file (used by file managers)
  ui                                        Open the manager window (installed apps, uninstall)
  info <file>                               Print JSON metadata for an AppImage
  run <file>                                Run an AppImage without installing
  integration                               JSON: launcher entry, file handler and command-line link state
  setup [--launcher B] [--handler B] [--cli B] [--done]
                                            Switch each piece of integration on or off (B is true|false)
  register                                  Same as: setup --launcher true --handler true
  unregister                                Switch all three off (installed apps are left alone)
  help                                      Show this help
EOF
}

slug() { tr '[:upper:] ' '[:lower:]-' <<<"$1" | tr -cd 'a-z0-9._-'; }

# --- app record: everything that belongs to one installed app --------------------
# One manifest ($DB_DIR/<id>.env, simple KEY=value lines), a launcher entry, an icon, a link in $BIN_DIR and the AppImage.
# Commands go through rec_* and never spell these paths themselves, so the layout lives here and nowhere else.
#   rec_exists ID / rec_external ID      is it installed / was it adopted rather than installed by us
#   rec_launcher ID / rec_icon ID        its launcher entry / its icon file (printed if it exists)
#   rec_install_icon ID FILE             copy the icon in place; prints the icon name for the launcher entry
#   rec_delete ID                        remove the app and every file of it
#   refresh_desktop_db                   tell the desktop its launcher entries changed
db_get() { sed -n "s/^$2=//p" "$DB_DIR/$1.env" | head -n1; }
db_write() { # id name source version [KEY=value ...]
  local id=$1 name=$2 source=$3 version=$4
  shift 4
  mkdir -p "$DB_DIR"
  {
    printf 'NAME=%s\nSOURCE=%s\nVERSION=%s\n' "$name" "$source" "$version"
    if (( $# )); then printf '%s\n' "$@"; fi
  } >"$DB_DIR/$id.env"
}
rec_exists() { [[ -f "$DB_DIR/$1.env" ]]; }
rec_external() { [[ "$(db_get "$1" EXTERNAL)" == 1 ]]; }
refresh_desktop_db() { if command -v update-desktop-database >/dev/null; then update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true; fi; }
rec_launcher() { local d; d=$(db_get "$1" DESKTOP); echo "${d:-$DESKTOP_DIR/startappimage-$1.desktop}"; }
rec_icon() { # the first icon file that exists: the adopted one, our png, our svg
  local i
  for i in "$(db_get "$1" ICON)" "$ICON_DIR/startappimage-$1.png" "$SVG_ICON_DIR/startappimage-$1.svg"; do
    if [[ -f $i ]]; then echo "$i"; return 0; fi
  done
}
rec_install_icon() { # id file -> the icon name for the launcher entry
  local ext=${2##*.}
  if [[ -f $2 ]]; then
    if [[ $ext == svg ]]; then mkdir -p "$SVG_ICON_DIR"; cp "$2" "$SVG_ICON_DIR/startappimage-$1.svg"
    else mkdir -p "$ICON_DIR"; cp "$2" "$ICON_DIR/startappimage-$1.png"; fi
    echo "startappimage-$1"
  else
    echo "application-x-executable"
  fi
}
rec_delete() {
  local id=$1
  if rec_external "$id"; then
    local exe desk icon
    exe=$(db_get "$id" EXEC); desk=$(db_get "$id" DESKTOP); icon=$(db_get "$id" ICON)
    [[ "$exe" == "$HOME"/* && ${exe,,} == *.appimage ]] || die "refusing to remove $exe"
    rm -f "$exe" "$DB_DIR/$id.env"
    [[ "$desk" != "$DESKTOP_DIR"/*.desktop ]] || rm -f "$desk"
    [[ "$icon" != "$HOME/.local/share/"* ]] || rm -f "$icon"
  else
    rm -f "$(app_exec "$id")" "$BIN_DIR/$id" "$(rec_launcher "$id")" \
          "$ICON_DIR/startappimage-$id.png" "$SVG_ICON_DIR/startappimage-$id.svg" "$DB_DIR/$id.env"
  fi
  refresh_desktop_db
}
# How an app is kept up to date: github (repo is owner/repo), url, external (adopted) or local. The SOURCE encoding stays here.
rec_source_kind() { local s; s=$(db_get "$1" SOURCE); echo "${s%%:*}"; }
rec_repo() { local s; s=$(db_get "$1" SOURCE); [[ $s != github:* ]] || echo "${s#github:}"; }
# Where an app's AppImage lives: adopted apps keep theirs where it was found.
app_exec() { local e; e=$(db_get "$1" EXEC); echo "${e:-$LEGACY_APP_DIR/$1.AppImage}"; }

# --- apps installed outside StartAppImage ---------------------------------------
# Launcher entries that point at an .AppImage are adopted into the manifest
# (EXTERNAL=1), so Open and Uninstall work on them like on any other app.
desktop_exec_path() { # desktop file -> the AppImage it launches, if it exists
  local line p
  line=$(sed -n 's/^Exec=//p' "$1" | head -n1)
  if [[ $line == \"* ]]; then p=${line#\"}; p=${p%%\"*}; else p=${line%% *}; fi
  if [[ ${p,,} == *.appimage && -f "$p" ]]; then echo "$p"; fi
}

find_icon() { # icon name or path -> a file path, or nothing
  local n=$1
  [[ -n "$n" ]] || return 0
  if [[ $n == /* ]]; then [[ ! -f "$n" ]] || echo "$n"; return 0; fi
  find "$HOME/.local/share/icons" "$HOME/.local/share/pixmaps" \( -name "$n.png" -o -name "$n.svg" \) 2>/dev/null | sort -V | tail -n1 || true
}

sync_external() {
  shopt -s nullglob
  local f d id path name icon version known exe
  for f in "$DB_DIR"/*.env; do # forget adopted apps whose file is gone
    id=$(basename "$f" .env)
    if rec_external "$id"; then
      exe=$(db_get "$id" EXEC)
      [[ -f "$exe" ]] || rm -f "$f"
    fi
  done
  for d in "$DESKTOP_DIR"/*.desktop; do
    case "$(basename "$d")" in startappimage*) continue ;; esac
    path=$(desktop_exec_path "$d")
    [[ -n "$path" ]] || continue
    path=$(realpath "$path")
    known=0
    for f in "$DB_DIR"/*.env; do
      id=$(basename "$f" .env)
      if [[ "$(realpath -m "$(app_exec "$id")")" == "$path" ]]; then known=1; break; fi
    done
    [[ $known -eq 0 ]] || continue
    name=$(sed -n 's/^Name=//p' "$d" | head -n1)
    id=$(slug "$name"); [[ -n "$id" ]] || id=$(slug "$(basename "$d" .desktop)")
    [[ ! -f "$DB_DIR/$id.env" ]] || id="$id-ext"
    version=$(sed -n 's/^X-AppImage-Version=//p' "$d" | head -n1)
    [[ -n "$version" ]] || version=$(basename "$path" | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1 || true)
    icon=$(find_icon "$(sed -n 's/^Icon=//p' "$d" | head -n1)")
    db_write "$id" "${name:-$id}" external "${version:-local}" EXTERNAL=1 "EXEC=$path" "DESKTOP=$d" "ICON=$icon"
  done
}

# --- github helpers ------------------------------------------------------------
gh_repo() { # "github:o/r", a github.com URL (releases page included) or "o/r" -> "o/r"
  local r=${1#github:}
  r=${r#https://github.com/}; r=${r#http://github.com/}; r=${r#github.com/}
  r=${r%%\?*}; r=${r%%#*}
  IFS=/ read -r r1 r2 _ <<<"$r"
  printf '%s/%s' "$r1" "${r2%.git}"
}

gh_pick() { # release JSON on stdin -> "tag<TAB>asset_url", the AppImage built for this CPU
  jq -r --arg a "$(uname -m)" '
    def tokens: {x86_64:"x86_64|amd64|x64", aarch64:"aarch64|arm64", armv7l:"armv7|armhf|arm32", i686:"i[3-6]86|x86_32"};
    def any: "x86_64|amd64|aarch64|arm64|armv7|armhf|i[3-6]86|riscv|ppc64";
    .tag_name as $t
    | [.assets[] | select(.name | test("\\.AppImage$"; "i"))] as $all
    | ($all | map(select(.name | test((tokens[$a] // $a); "i"))) | first)
      // ($all | map(select(.name | test(any; "i") | not)) | first) as $x
    | "\($t)\t\($x.browser_download_url // "")"'
}

gh_latest() { # owner/repo -> "tag<TAB>asset_url"
  curl -fsSL "https://api.github.com/repos/$1/releases/latest" | gh_pick
}

# resolve <link|owner/repo>: JSON for the UI. {ok, repo, tag, asset, kind, error}
# kind: invalid | notfound | noasset | network (the last one does not stop a save).
cmd_resolve() {
  need jq; need curl
  local repo body code tag url assets
  repo=$(gh_repo "${1:-}")
  res() { jq -n --argjson ok "$1" --arg repo "$repo" --arg tag "${tag:-}" --arg asset "$(basename "${url:-}")" --arg kind "${2:-}" --arg error "${3:-}" \
    '{ok:$ok, repo:$repo, tag:$tag, asset:$asset, kind:$kind, error:$error}'; }
  if [[ ! $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then res false invalid "Use a GitHub link or owner/repo"; return 0; fi
  body=$(curl -sS --max-time 15 -w '\n%{http_code}' "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null) || { res false network "Could not reach GitHub"; return 0; }
  code=${body##*$'\n'}; body=${body%$'\n'*}
  case $code in
    200) ;;
    404) res false notfound "No GitHub repository or release found at $repo"; return 0 ;;
    *) res false network "GitHub answered $code, try again later"; return 0 ;;
  esac
  IFS=$'\t' read -r tag url < <(gh_pick <<<"$body")
  if [[ -z $url ]]; then
    assets=$(jq -r '[.assets[].name | select(test("\\.AppImage$"; "i"))] | join(", ")' <<<"$body")
    res false noasset "The latest release has no AppImage for $(uname -m)${assets:+ (found: $assets)}"; return 0
  fi
  res true
}

# --- metadata ------------------------------------------------------------------
# extract_meta <appimage> <tmpdir> [fallback-name]
# Sets M_NAME M_COMMENT M_CATS M_ICON (path or empty). Runs the AppImage only with --appimage-extract.
extract_meta() {
  local file=$1 tmp=$2 fallback=${3:-} root desktop icon_name run=$1
  root="$tmp/squashfs-root"
  if [[ ! -x "$file" ]]; then # never chmod the user's own file; work on a copy
    run="$tmp/app.AppImage"; cp --reflink=auto "$file" "$run"; chmod +x "$run"
  fi
  # Pull out only the metadata: a full extraction of a 300 MB app is slow.
  ( cd "$tmp" && "$run" --appimage-extract '*.desktop' >/dev/null 2>&1 && "$run" --appimage-extract '.DirIcon' >/dev/null 2>&1 ) || true
  desktop=$(find "$root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1 || true)
  if [[ -z "$desktop" ]]; then
    ( cd "$tmp" && "$run" --appimage-extract >/dev/null 2>&1 ) || die "not a valid AppImage (extraction failed)"
    desktop=$(find "$root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1 || true)
  fi
  M_NAME=$fallback M_COMMENT="" M_CATS="Utility;" M_ICON="" M_VERSION=""
  if [[ -n "$desktop" ]]; then
    M_NAME=$(sed -n 's/^Name=//p' "$desktop" | head -n1); M_NAME=${M_NAME:-$fallback}
    M_CATS=$(sed -n 's/^Categories=//p' "$desktop" | head -n1); M_CATS=${M_CATS:-Utility;}
    M_COMMENT=$(sed -n 's/^Comment=//p' "$desktop" | head -n1)
    M_VERSION=$(sed -n 's/^X-AppImage-Version=//p' "$desktop" | head -n1)
    icon_name=$(sed -n 's/^Icon=//p' "$desktop" | head -n1)
    ( cd "$tmp" && "$run" --appimage-extract "$icon_name.*" >/dev/null 2>&1; "$run" --appimage-extract 'usr/share/icons/*' >/dev/null 2>&1 ) || true
    M_ICON=$(find "$root" -maxdepth 1 \( -name "$icon_name.png" -o -name "$icon_name.svg" \) | head -n1 || true)
    [[ -n "$M_ICON" ]] || M_ICON=$(find "$root/usr/share/icons" -name "$icon_name.png" 2>/dev/null | sort -V | tail -n1 || true)
  fi
  [[ -n "$M_ICON" ]] || M_ICON=$(readlink -f "$root/.DirIcon" 2>/dev/null || true)
  [[ -f "$M_ICON" ]] || M_ICON=""
}

# info <file>: JSON preview for the install window (icon is copied to the cache dir).
cmd_info() {
  [[ $# -eq 1 && -f "$1" ]] || die "info: missing file"
  need jq
  local tmp cache="${XDG_CACHE_HOME:-$HOME/.cache}/startappimage" icon="" id installed=false
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  extract_meta "$1" "$tmp" "$(basename "$1" .AppImage)"
  if [[ -n "$M_ICON" ]]; then
    mkdir -p "$cache"; icon="$cache/preview-$$.${M_ICON##*.}"; cp "$M_ICON" "$icon"
  fi
  sync_external
  local iversion="" idir=""
  id=$(slug "$M_NAME")
  if rec_exists "$id"; then installed=true; iversion=$(db_get "$id" VERSION); idir=$(dirname "$(app_exec "$id")"); fi
  jq -nc --arg name "$M_NAME" --arg comment "$M_COMMENT" --arg cats "$M_CATS" --arg icon "$icon" \
    --arg version "$M_VERSION" --arg size "$(du -h "$1" | cut -f1)" --arg path "$(realpath "$1")" --arg id "$id" \
    --arg installedVersion "$iversion" --arg installedDir "$idir" --argjson installed "$installed" \
    '{name:$name,comment:$comment,categories:$cats,icon:$icon,version:$version,size:$size,path:$path,id:$id,installed:$installed,installedVersion:$installedVersion,installedDir:$installedDir}'
}

# run <file|id>: run an AppImage file, or an installed app by id.
cmd_run() {
  local t=${1:-}
  [[ -f "$t" ]] || t=$(app_exec "$(slug "$t")")
  [[ -f "$t" ]] || die "run: no such file or installed app: ${1:-}"
  chmod +x "$t"; exec "$(realpath "$t")"
}

# --- add -----------------------------------------------------------------------
cmd_add() {
  local dest="$APP_DIR" remember=0 args=()
  wants_json "$@"
  while (( $# )); do
    case "$1" in
      --json) shift ;;
      --dir) [[ $# -ge 2 ]] || die "add: --dir needs a folder"; dest=$2; remember=1; shift 2 ;;
      --dir=*) dest=${1#--dir=}; remember=1; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}
  [[ $# -ge 1 ]] || die "add: missing source"
  dest=$(expand_dir "$dest")
  inside_home "$dest" || DIE_FIELD=dir die "the install folder must be inside your home directory: $dest"
  need curl
  local src="$1" name="${2:-}" explicit="${2:-}" tmp file version="local" source_rec="local"
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN

  case "$src" in
    github:*|https://github.com/*|http://github.com/*|github.com/*)
      need jq
      local repo tag url; repo=$(gh_repo "$src")
      IFS=$'\t' read -r tag url < <(gh_latest "$repo")
      [[ -n "$url" ]] || die "no AppImage asset in latest release of $repo"
      file="$tmp/download.AppImage"; say "Downloading $url"
      curl -fL --progress-bar -o "$file" "$url"
      version=$tag; source_rec="github:$repo"
      [[ -n "$name" ]] || name=${repo#*/} ;;
    http://*|https://*)
      file="$tmp/download.AppImage"; curl -fL --progress-bar -o "$file" "$src"
      source_rec="url:$src"; [[ -n "$name" ]] || name=$(basename "${src%%\?*}" .AppImage) ;;
    *)
      [[ -f "$src" ]] || die "no such file: $src"
      file="$tmp/download.AppImage"; cp "$src" "$file"
      [[ -n "$name" ]] || name=$(basename "$src" .AppImage) ;;
  esac
  chmod +x "$file"

  say "Reading application metadata..."
  extract_meta "$file" "$tmp" "$name"
  local display=$M_NAME comment=$M_COMMENT cats=$M_CATS icon_src=$M_ICON
  [[ $version != local || -z "$M_VERSION" ]] || version=$M_VERSION
  [[ -n "$explicit" ]] || name=$display

  local id; id=$(slug "$name")
  [[ -n "$id" ]] || id=$(slug "$(basename "$src" .AppImage)")
  [[ -n "$id" ]] || die "could not derive a name; pass one explicitly"
  say "Installing to $dest..."
  # Installing again into a different folder moves the app: clear the old copy first.
  if rec_exists "$id" && [[ "$(app_exec "$id")" != "$dest/$id.AppImage" ]]; then
    cmd_remove "$id" >/dev/null
  fi
  mkdir -p "$dest" "$DESKTOP_DIR" "$BIN_DIR"

  mv "$file" "$dest/$id.AppImage"
  ln -sf "$dest/$id.AppImage" "$BIN_DIR/$id"

  local icon_ref; icon_ref=$(rec_install_icon "$id" "$icon_src")

  cat >"$(rec_launcher "$id")" <<EOF
[Desktop Entry]
Type=Application
Name=$display
Comment=$comment
Exec="$dest/$id.AppImage" %U
Icon=$icon_ref
Categories=$cats
Terminal=false
X-StartAppImage=$id
EOF
  db_write "$id" "$display" "$source_rec" "$version" "EXEC=$dest/$id.AppImage"
  [[ $remember -eq 0 ]] || cfg_set INSTALL_DIR "$dest"
  refresh_desktop_db
  if [[ $JSON_RESULT == 1 ]]; then jq -nc --arg id "$id" --arg name "$display" '{ok:true, id:$id, name:$name}'
  else echo "Installed $display ($id)"; fi
}

# --- per-app settings --------------------------------------------------------------
db_set() { # id KEY value: replace or add one line of an app's manifest
  local f="$DB_DIR/$1.env"
  { grep -v "^$2=" "$f" || true; echo "$2=$3"; } >"$f.tmp" && mv "$f.tmp" "$f"
}

desktop_set() { # file KEY value: replace the first KEY= line, or add it under [Desktop Entry]
  local f=$1
  if grep -q "^$2=" "$f"; then
    K="$2" V="$3" awk 'index($0, ENVIRON["K"] "=") == 1 && !d { print ENVIRON["K"] "=" ENVIRON["V"]; d = 1; next } { print }' "$f" >"$f.tmp"
  else
    K="$2" V="$3" awk '{ print } /^\[Desktop Entry\]/ && !d { print ENVIRON["K"] "=" ENVIRON["V"]; d = 1 }' "$f" >"$f.tmp"
  fi
  mv "$f.tmp" "$f"
}
desktop_unset() { { grep -v "^$2=" "$1" || true; } >"$1.tmp"; mv "$1.tmp" "$1"; }

exec_line() { sed -n 's/^Exec=//p' "$1" | head -n1; }
exec_args() { # the arguments of a launcher's Exec line, without the program and the field codes
  local line rest
  line=$(exec_line "$1")
  if [[ $line == \"* ]]; then rest=${line#\"}; rest=${rest#*\"}; else rest=${line#* }; [[ "$rest" != "$line" ]] || rest=""; fi
  sed -E 's/ ?%[a-zA-Z]//g; s/^ +//; s/ +$//' <<<"$rest"
}
exec_code() { exec_line "$1" | grep -oE '%[fFuU]' | tail -n1 || true; }
write_exec() { # desktop-file program arguments
  local code line; code=$(exec_code "$1")
  line="\"$2\""
  [[ -z "$3" ]] || line+=" $3"
  [[ -z "$code" ]] || line+=" $code"
  desktop_set "$1" Exec "$line"
}

cmd_config() {
  need jq; sync_external
  [[ $# -eq 1 ]] || die "config: missing name"
  local id exe desk src hidden=false external=false
  id=$(slug "$1")
  rec_exists "$id" || die "not installed: $id"
  exe=$(app_exec "$id"); desk=$(rec_launcher "$id"); src=$(db_get "$id" SOURCE)
  local dargs=""
  if [[ -f "$desk" ]]; then
    if grep -q '^NoDisplay=true' "$desk"; then hidden=true; fi
    dargs=$(exec_args "$desk")
  fi
  rec_external "$id" && external=true
  jq -nc --arg id "$id" --arg name "$(db_get "$id" NAME)" --arg path "$exe" --arg dir "$(dirname "$exe")" \
    --arg args "$dargs" --arg source "$src" --arg kind "$(rec_source_kind "$id")" --arg repo "$(rec_repo "$id")" --arg version "$(db_get "$id" VERSION)" \
    --argjson hidden "$hidden" --argjson external "$external" \
    '{id:$id,name:$name,path:$path,dir:$dir,args:$args,source:$source,sourceKind:$kind,repo:$repo,version:$version,hidden:$hidden,external:$external}'
}

cmd_set() {
  wants_json "$@"
  [[ $# -ge 1 ]] || die "set: missing name"
  local id; id=$(slug "$1"); shift
  rec_exists "$id" || die "not installed: $id"
  local desk exe new_dir="" new_name="" new_args="" new_source="" new_hidden=""
  local has_name=0 has_args=0 has_source=0
  while (( $# )); do
    case "$1" in
      --json) shift ;;
      --dir) [[ $# -ge 2 ]] || die "set: --dir needs a folder"; new_dir=$2; shift 2 ;;
      --name) [[ $# -ge 2 ]] || die "set: --name needs a value"; new_name=$2; has_name=1; shift 2 ;;
      --args) [[ $# -ge 2 ]] || die "set: --args needs a value"; new_args=$2; has_args=1; shift 2 ;;
      --source) [[ $# -ge 2 ]] || die "set: --source needs a value"; new_source=$2; has_source=1; shift 2 ;;
      --hidden) [[ $# -ge 2 ]] || die "set: --hidden needs true or false"; new_hidden=$2; shift 2 ;;
      *) die "set: unknown option $1" ;;
    esac
  done
  desk=$(rec_launcher "$id"); exe=$(app_exec "$id")
  [[ -f "$desk" ]] || die "launcher entry not found: $desk"

  if [[ -n "$new_dir" ]]; then
    new_dir=$(expand_dir "$new_dir")
    inside_home "$new_dir" || DIE_FIELD=dir die "the folder must be inside your home directory: $new_dir"
    if [[ "$new_dir" != "$(dirname "$exe")" ]]; then
      local target
      if rec_external "$id"; then target="$new_dir/$(basename "$exe")"; else target="$new_dir/$id.AppImage"; fi
      [[ ! -e "$target" ]] || DIE_FIELD=dir die "$target already exists"
      mkdir -p "$new_dir"
      mv "$exe" "$target"
      rec_external "$id" || ln -sf "$target" "$BIN_DIR/$id"
      db_set "$id" EXEC "$target"
      write_exec "$desk" "$target" "$(exec_args "$desk")"
      exe=$target
    fi
  fi
  if [[ $has_args -eq 1 ]]; then write_exec "$desk" "$exe" "$new_args"; fi
  if [[ $has_name -eq 1 && -n "$new_name" ]]; then
    db_set "$id" NAME "$new_name"; desktop_set "$desk" Name "$new_name"
  fi
  if [[ $has_source -eq 1 ]]; then
    local repo=""
    [[ -z "$new_source" ]] || repo=$(gh_repo "$new_source")
    if [[ -z "$repo" ]]; then
      if rec_external "$id"; then db_set "$id" SOURCE external; else db_set "$id" SOURCE local; fi
    else
      [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || DIE_FIELD=source die "the update source must look like owner/repo"
      db_set "$id" SOURCE "github:$repo"
    fi
  fi
  case "$new_hidden" in
    true) desktop_set "$desk" NoDisplay true ;;
    false) desktop_unset "$desk" NoDisplay ;;
    "") ;;
    *) DIE_FIELD=hidden die "set: --hidden takes true or false" ;;
  esac
  refresh_desktop_db
  if [[ $JSON_RESULT == 1 ]]; then jq -nc --arg id "$id" '{ok:true, id:$id}'; else echo "Saved $id"; fi
}

# folder <path>: JSON {ok, path, error} for the folder field; the same rule add and set apply.
cmd_folder() {
  need jq
  local p; p=$(expand_dir "${1:-}")
  if inside_home "$p"; then jq -nc --arg path "$p" '{ok:true, path:$path, error:""}'
  else jq -nc --arg path "$p" '{ok:false, path:$path, error:"The folder must be inside your home directory."}'; fi
}

# --- locations -------------------------------------------------------------------
# JSON for the install card: the default folder, plus every folder AppImages already live in.
cmd_locations() {
  need jq; sync_external
  shopt -s nullglob
  local -a dirs=("$APP_DIR" "$LEGACY_APP_DIR")
  local f id d seen="" out=""
  [[ ! -d "$HOME/Applications" ]] || dirs+=("$HOME/Applications")
  for f in "$DB_DIR"/*.env; do
    id=$(basename "$f" .env); dirs+=("$(dirname "$(app_exec "$id")")")
  done
  for d in "${dirs[@]}"; do
    d=${d%/}
    [[ -d "$d" || "$d" == "$APP_DIR" ]] || continue
    case $'\n'"$seen" in *$'\n'"$d"$'\n'*) continue ;; esac
    seen+=$'\n'"$d"$'\n'
    local -a found=("$d"/*.AppImage)
    out+="$d"$'\t'"${#found[@]}"$'\n'
  done
  printf '%s' "$out" | jq -Rn --arg def "$APP_DIR" \
    '{default:$def, options:[inputs | select(length > 0) | split("\t") | {path:.[0], apps:(.[1] | tonumber)}]}'
}

# --- list ----------------------------------------------------------------------
cmd_list() {
  shopt -s nullglob
  sync_external
  local first=1 f id
  [[ ${1:-} == --json ]] && echo "["
  for f in "$DB_DIR"/*.env; do
    id=$(basename "$f" .env)
    if [[ ${1:-} == --json ]]; then
      [[ $first -eq 1 ]] || echo ","; first=0
      local icon external=false
      rec_external "$id" && external=true
      icon=$(rec_icon "$id")
      jq -nc --arg id "$id" --arg name "$(db_get "$id" NAME)" --arg source "$(db_get "$id" SOURCE)" \
        --arg version "$(db_get "$id" VERSION)" --arg icon "$icon" \
        --arg kind "$(rec_source_kind "$id")" --arg repo "$(rec_repo "$id")" \
        --arg exec "$(app_exec "$id")" --argjson external "$external" \
        '{id:$id,name:$name,source:$source,sourceKind:$kind,repo:$repo,version:$version,icon:$icon,exec:$exec,external:$external}'
    else
      printf '%-24s %-12s %s\n' "$id" "$(db_get "$id" VERSION)" "$(db_get "$id" SOURCE)"
    fi
  done
  [[ ${1:-} == --json ]] && echo "]"
  return 0
}

# --- check / update ------------------------------------------------------------
# Prints "id<TAB>current<TAB>latest<TAB>url" for each updatable app.
pending_updates() {
  need jq; shopt -s nullglob
  local f id src tag url
  for f in "$DB_DIR"/"${1:-}"*.env; do
    id=$(basename "$f" .env); [[ -z "${1:-}" || $id == "$1" ]] || continue
    src=$(db_get "$id" SOURCE); [[ $src == github:* ]] || continue
    IFS=$'\t' read -r tag url < <(gh_latest "$(gh_repo "$src")") || continue
    [[ -n "$url" && "${tag#v}" != "$(db_get "$id" VERSION | sed 's/^v//')" ]] && printf '%s\t%s\t%s\t%s\n' "$id" "$(db_get "$id" VERSION)" "$tag" "$url"
  done
  return 0
}

cmd_check() {
  # The bar icon lights up from this count.
  local found; found=$(pending_updates)
  mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/startappimage"
  printf '%s\n' "$(grep -c . <<<"$found" || true)" >"${XDG_CACHE_HOME:-$HOME/.cache}/startappimage/updates"
  if [[ ${1:-} == --json ]]; then
    printf '%s' "$found" | jq -Rn '[inputs|split("\t")|{id:.[0],current:.[1],latest:.[2]}]'
  else
    printf '%s' "$found" | awk -F'\t' '{printf "%s: %s -> %s\n",$1,$2,$3}'
  fi
}

cmd_update() {
  local id cur tag url tmp
  while IFS=$'\t' read -r id cur tag url; do
    echo "Updating $id: $cur -> $tag"
    tmp=$(mktemp); curl -fL --progress-bar -o "$tmp" "$url"
    chmod +x "$tmp"; mv "$tmp" "$(app_exec "$id")"
    # Only the version changes: the rest of the manifest (EXTERNAL, ICON, DESKTOP, ...) stays.
    db_set "$id" VERSION "$tag"
  done < <(pending_updates "${1:-}")
  echo "Done."
}

# --- remove --------------------------------------------------------------------
cmd_remove() {
  wants_json "$@"
  local a args=()
  for a in "$@"; do [[ $a == --json ]] || args+=("$a"); done
  set -- ${args[@]+"${args[@]}"}
  [[ $# -eq 1 ]] || die "remove: missing name"
  local id; id=$(slug "$1")
  rec_exists "$id" || die "not installed: $id"
  rec_delete "$id"
  if [[ $JSON_RESULT == 1 ]]; then jq -nc --arg id "$id" '{ok:true, id:$id}'; else echo "Removed $id"; fi
}

# --- open / register -----------------------------------------------------------
choose() { # reads options on stdin, prints the pick; falls back to integrating
  if command -v walker >/dev/null; then walker --dmenu
  elif command -v fuzzel >/dev/null; then fuzzel --dmenu
  elif command -v wofi >/dev/null; then wofi --dmenu
  elif command -v rofi >/dev/null; then rofi -dmenu
  else echo "Integrate and run"; fi
}

cmd_open() {
  [[ $# -ge 1 && -f "$1" ]] || die "open: missing file"
  local f pick id
  f=$(realpath "$1")
  case "$f" in "$LEGACY_APP_DIR"/*) chmod +x "$f"; exec "$f" ;; esac # already managed
  # The StartAppImage shell plugin shows the install card; without it, fall back to a picker.
  if command -v omarchy-shell >/dev/null && omarchy-shell "$PLUGIN_ID" install "$f" >/dev/null 2>&1; then
    exit 0
  fi
  pick=$(printf 'Integrate and run\nRun once\n' | choose) || exit 0
  case "$pick" in
    Integrate*)
      id=$(slug "$(basename "$f" .AppImage)")
      cmd_add "$f"
      notify-send "StartAppImage" "Installed $id" 2>/dev/null || true
      exec "$(app_exec "$id")" ;;
    "Run once") chmod +x "$f" 2>/dev/null || true; exec "$f" ;;
  esac
}

# --- setup: launcher entry, file handler, command line ----------------------------
# Three independent pieces of desktop integration, each switched on or off on its own.
MIME_TYPES="application/vnd.appimage application/x-iso9660-appimage"
OPEN_DESKTOP="startappimage-open.desktop"
CLI_LINK="$BIN_DIR/startappimage"
SELF=$(realpath "$0")

mime_default() { xdg-mime query default application/vnd.appimage 2>/dev/null || true; }
is_true() { [[ $1 == true ]]; }

launcher_on() {
  mkdir -p "$DESKTOP_DIR" "$SVG_ICON_DIR"
  cat >"$DESKTOP_DIR/startappimage.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=StartAppImage
GenericName=AppImage Manager
Comment=Install, update and uninstall AppImages
Exec=$SELF ui
Icon=startappimage
Categories=System;Utility;
Keywords=appimage;install;uninstall;manager;
Terminal=false
DESKTOP
  cp "$(dirname "$SELF")/../assets/startappimage.svg" "$SVG_ICON_DIR/startappimage.svg"
  refresh_desktop_db
}

launcher_off() {
  rm -f "$DESKTOP_DIR/startappimage.desktop" "$SVG_ICON_DIR/startappimage.svg"
  refresh_desktop_db
}

handler_on() {
  need xdg-mime; mkdir -p "$DESKTOP_DIR"
  local prev; prev=$(mime_default)
  # Remember what opened AppImages before, so switching this off can give it back.
  if [[ -n $prev && $prev != "$OPEN_DESKTOP" ]]; then cfg_set PREVIOUS_HANDLER "$prev"; fi
  cat >"$DESKTOP_DIR/$OPEN_DESKTOP" <<DESKTOP
[Desktop Entry]
Type=Application
Name=StartAppImage
Comment=Install or run AppImages
Exec=$SELF open %f
Icon=application-x-executable
MimeType=application/vnd.appimage;application/x-iso9660-appimage;
NoDisplay=true
Terminal=false
DESKTOP
  refresh_desktop_db
  # shellcheck disable=SC2086
  xdg-mime default "$OPEN_DESKTOP" $MIME_TYPES
}

handler_off() {
  local mime="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" prev t
  prev=$(cfg_get PREVIOUS_HANDLER)
  rm -f "$DESKTOP_DIR/$OPEN_DESKTOP"
  if [[ -f $mime ]]; then
    sed -i '/^application\/vnd\.appimage=startappimage-open\.desktop$/d;/^application\/x-iso9660-appimage=startappimage-open\.desktop$/d' "$mime"
  fi
  refresh_desktop_db
  if [[ -n $prev ]] && [[ -f "$DESKTOP_DIR/$prev" || -f "/usr/share/applications/$prev" ]] && command -v xdg-mime >/dev/null; then
    for t in $MIME_TYPES; do xdg-mime default "$prev" "$t"; done
  fi
}

# ours | other | none: whose file, if any, sits at ~/.local/bin/startappimage
cli_state() {
  if [[ -L $CLI_LINK && $(realpath "$CLI_LINK" 2>/dev/null) == "$SELF" ]]; then echo ours
  elif [[ -e $CLI_LINK || -L $CLI_LINK ]]; then echo other
  else echo none; fi
}

cli_on() {
  case $(cli_state) in
    ours) return 0 ;;
    other) setup_fail cli "$(short_home "$CLI_LINK") already exists and is not StartAppImage, so it was left alone"; return 1 ;;
  esac
  mkdir -p "$BIN_DIR"
  ln -s "$SELF" "$CLI_LINK"
}

# The first piece of setup that failed: its name and why. Printed for a person, or as the JSON result with --json.
SETUP_FIELD="" SETUP_ERROR=""
setup_fail() { if [[ -z $SETUP_ERROR ]]; then SETUP_FIELD=$1 SETUP_ERROR=$2; fi; if [[ $JSON_RESULT != 1 ]]; then echo "startappimage: $2" >&2; fi; }

cli_off() { [[ $(cli_state) != ours ]] || rm -f "$CLI_LINK"; }

short_home() { local p=$1; [[ $p == "$HOME"/* ]] && p="~${p#"$HOME"}"; printf '%s' "$p"; }

# The recommended settings, in one place: what a first run offers, what Reset goes back to,
# and what a setting reads as before anyone changed it. `integration` hands them to the UI as "defaults".
DEFAULT_LAUNCHER=true
DEFAULT_HANDLER=true
DEFAULT_CLI=true
DEFAULT_BAR_ICON=false
DEFAULT_CHECK_HOURS=6
DEFAULT_REMEMBER=true

# JSON for the setup card: what is switched on, and what would be replaced.
cmd_integration() {
  need jq
  local launcher=false h hname="" ours=false
  [[ ! -f $DESKTOP_DIR/startappimage.desktop ]] || launcher=true
  h=$(mime_default)
  if [[ $h == "$OPEN_DESKTOP" ]]; then ours=true
  elif [[ -n $h ]]; then
    hname=$(sed -n 's/^Name=//p' "$DESKTOP_DIR/$h" "/usr/share/applications/$h" 2>/dev/null | head -n1 || true)
    hname=${hname:-${h%.desktop}}
  fi
  # Existing users who ran `register` before the setup card existed are already set up.
  local finished=false
  { [[ $(cfg_get SETUP_DONE) == 1 ]] || { [[ $launcher == true && $ours == true ]]; }; } && finished=true
  jq -n --argjson launcher "$launcher" --argjson ours "$ours" --argjson finished "$finished" \
    --arg handler "$h" --arg handlerName "$hname" --arg cli "$(cli_state)" --arg cliPath "$(short_home "$CLI_LINK")" --argjson hours "$(cfg_get CHECK_HOURS | grep -E '^[0-9]+$' || echo "$DEFAULT_CHECK_HOURS")" \
    --argjson baricon "$(bar_icon_state)" \
    --argjson rsize "$(cfg_bool REMEMBER_SIZE)" \
    --argjson rpos "$(cfg_bool REMEMBER_POSITION)" \
    --argjson dlauncher "$DEFAULT_LAUNCHER" --argjson dhandler "$DEFAULT_HANDLER" --argjson dcli "$DEFAULT_CLI" --argjson dbar "$DEFAULT_BAR_ICON" \
    --argjson dhours "$DEFAULT_CHECK_HOURS" --argjson dremember "$DEFAULT_REMEMBER" \
    '{launcher:$launcher, handler:{ours:$ours, current:$handler, name:$handlerName}, cli:{state:$cli, path:$cliPath}, checkHours:$hours, barIcon:$baricon, rememberSize:$rsize, rememberPosition:$rpos, done:$finished,
      defaults:{launcher:$dlauncher, handler:$dhandler, cli:$dcli, barIcon:$dbar, checkHours:$dhours, rememberSize:$dremember, rememberPosition:$dremember}}'
}

# setup [--launcher true|false] [--handler true|false] [--cli true|false] [--done]
# Only what is named is touched. --done records that the setup card has been answered.
cmd_setup() {
  local launcher="" handler="" cli="" hours="" rsize="" rpos="" baricon="" mark=0 failed=0
  wants_json "$@"
  while (( $# )); do
    case $1 in
      --json) shift ;;
      --launcher|--handler|--cli)
        [[ ${2:-} == true || ${2:-} == false ]] || die "setup: $1 takes true or false"
        case $1 in --launcher) launcher=$2 ;; --handler) handler=$2 ;; --cli) cli=$2 ;; esac
        shift 2 ;;
      --bar-icon)
        [[ ${2:-} == true || ${2:-} == false ]] || die "setup: --bar-icon takes true or false"
        baricon=$2; shift 2 ;;
      --remember-size|--remember-position)
        [[ ${2:-} == true || ${2:-} == false ]] || die "setup: $1 takes true or false"
        case $1 in --remember-size) rsize=$2 ;; --remember-position) rpos=$2 ;; esac
        shift 2 ;;
      --check-hours)
        [[ ${2:-} =~ ^[0-9]+$ ]] || die "setup: --check-hours takes a number of hours (0 turns checks off)"
        hours=$2; shift 2 ;;
      --done) mark=1; shift ;;
      *) die "setup: unknown option $1" ;;
    esac
  done
  if [[ -n $launcher ]]; then if is_true "$launcher"; then launcher_on; else launcher_off; fi; fi
  if [[ -n $handler ]]; then if is_true "$handler"; then handler_on; else handler_off; fi; fi
  if [[ -n $cli ]]; then
    if is_true "$cli"; then cli_on || failed=1; else cli_off; fi
  fi
  [[ -z $hours ]] || cfg_set CHECK_HOURS "$hours"
  # Switching one off also forgets what was saved, so the next open starts from the default.
  if [[ -n $rsize ]]; then cfg_set REMEMBER_SIZE "$rsize"; is_true "$rsize" || { cfg_set WIN_W ""; cfg_set WIN_H ""; cfg_set SETUP_W ""; cfg_set SETUP_H ""; }; fi
  if [[ -n $rpos ]]; then cfg_set REMEMBER_POSITION "$rpos"; is_true "$rpos" || { cfg_set WIN_X ""; cfg_set WIN_Y ""; cfg_set SETUP_X ""; cfg_set SETUP_Y ""; }; fi
  [[ $mark -eq 0 && -z $launcher$handler$cli$hours$rsize$rpos$baricon ]] || cfg_set SETUP_DONE 1
  # Last: changing the bar makes the shell reload its config, which can restart the plugin
  # (and this process) part-way through.
  [[ -z $baricon ]] || bar_icon_set "$baricon" || failed=1
  if [[ $JSON_RESULT == 1 ]]; then
    if (( failed )); then jq -nc --arg field "$SETUP_FIELD" --arg error "$SETUP_ERROR" '{ok:false, field:$field, error:$error}'
    else jq -nc '{ok:true}'; fi
  fi
  return $failed
}

cmd_register() { cmd_setup --launcher true --handler true; echo "Registered as default handler for AppImage files"; }
cmd_unregister() {
  cmd_setup --launcher false --handler false --cli false
  echo "Unregistered: AppImage files no longer open with StartAppImage"
}

# --- bar icon (optional) -----------------------------------------------------
# The plugin is also a bar widget. It sits on the bar only when the layout in shell.json lists it,
# so adding or removing the icon edits that layout and leaves the plugin itself enabled.
BAR_ID="${PLUGIN_ID:-io.github.bmaltais.startappimage}"
bar_shell_json() { local f="$HOME/.config/omarchy/shell.json"; [[ -s $f ]] || f="${OMARCHY_PATH:-/usr/share/omarchy}/config/omarchy/shell.json"; printf '%s' "$f"; }
bar_icon_state() { # true | false
  local f; f=$(bar_shell_json)
  jq -e --arg id "$BAR_ID" '[.bar.layout[]?[]? | if type == "object" then .id else . end] | index($id) != null' "$f" >/dev/null 2>&1 && echo true || echo false
}
bar_icon_set() {
  command -v omarchy-shell-config >/dev/null || { setup_fail barIcon "the Omarchy bar is not available here"; return 1; }
  if is_true "$1"; then
    [[ $(bar_icon_state) == true ]] && return 0
    ( source omarchy-shell-config; commit "$NORMALIZE | .bar.layout.right += [{id: \$id}]" --arg id "$BAR_ID" )
  else
    [[ $(bar_icon_state) == false ]] && return 0
    ( source omarchy-shell-config; commit "$NORMALIZE | .bar.layout |= with_entries(.value |= (if type == \"array\" then map(select((if type == \"object\" then .id else . end) != \$id)) else . end))" --arg id "$BAR_ID" )
  fi
}

# window [--size WxH] [--offset X,Y] [--reset] [--setup-size WxH] [--setup-offset X,Y] [--reset-setup]
# The manager's and the settings window's size and offset from the screen centre. No option prints them as JSON.
cmd_window() {
  need jq
  while (( $# )); do
    case $1 in
      --size) [[ ${2:-} =~ ^[0-9]+x[0-9]+$ ]] || die "window: --size takes WIDTHxHEIGHT"
        cfg_set WIN_W "${2%x*}"; cfg_set WIN_H "${2#*x}"; shift 2 ;;
      --offset) [[ ${2:-} =~ ^-?[0-9]+,-?[0-9]+$ ]] || die "window: --offset takes X,Y"
        cfg_set WIN_X "${2%,*}"; cfg_set WIN_Y "${2#*,}"; shift 2 ;;
      --setup-size) [[ ${2:-} =~ ^[0-9]+x[0-9]+$ ]] || die "window: --setup-size takes WIDTHxHEIGHT"
        cfg_set SETUP_W "${2%x*}"; cfg_set SETUP_H "${2#*x}"; shift 2 ;;
      --setup-offset) [[ ${2:-} =~ ^-?[0-9]+,-?[0-9]+$ ]] || die "window: --setup-offset takes X,Y"
        cfg_set SETUP_X "${2%,*}"; cfg_set SETUP_Y "${2#*,}"; shift 2 ;;
      --reset) for k in WIN_W WIN_H WIN_X WIN_Y; do cfg_set "$k" ""; done; shift ;;
      --reset-setup) for k in SETUP_W SETUP_H SETUP_X SETUP_Y; do cfg_set "$k" ""; done; shift ;;
      *) die "window: unknown option $1" ;;
    esac
  done
  local k v out=()
  for k in WIN_W WIN_H WIN_X WIN_Y SETUP_W SETUP_H SETUP_X SETUP_Y; do v=$(cfg_get "$k"); [[ $v =~ ^-?[0-9]+$ ]] || v=0; out+=("$v"); done
  # While remembering is off nothing saved is reported, whatever an older config still holds.
  if [[ $(cfg_bool REMEMBER_SIZE) == false ]]; then out[0]=0 out[1]=0 out[4]=0 out[5]=0; fi
  if [[ $(cfg_bool REMEMBER_POSITION) == false ]]; then out[2]=0 out[3]=0 out[6]=0 out[7]=0; fi
  jq -n --argjson w "${out[0]}" --argjson h "${out[1]}" --argjson x "${out[2]}" --argjson y "${out[3]}" \
    --argjson sw "${out[4]}" --argjson sh "${out[5]}" --argjson sx "${out[6]}" --argjson sy "${out[7]}" \
    '{w:$w, h:$h, x:$x, y:$y, setup:{w:$sw, h:$sh, x:$sx, y:$sy}}'
}

case "${1:-help}" in
  open) shift; cmd_open "$@" ;;
  ui) omarchy-shell "$PLUGIN_ID" open || die "the StartAppImage plugin is not running (omarchy plugin enable $PLUGIN_ID)" ;;
  info) shift; cmd_info "$@" ;;
  locations) cmd_locations ;;
  resolve) shift; cmd_resolve "$@" ;;
  window) shift; cmd_window "$@" ;;
  folder) shift; cmd_folder "$@" ;;
  config) shift; cmd_config "$@" ;;
  set) shift; cmd_set "$@" ;;
  run) shift; cmd_run "$@" ;;
  integration) cmd_integration ;;
  setup) shift; cmd_setup "$@" ;;
  register) cmd_register ;;
  unregister) cmd_unregister ;;
  add) shift; cmd_add "$@" ;;
  list) shift; cmd_list "$@" ;;
  check) shift; cmd_check "$@" ;;
  update) shift; cmd_update "$@" ;;
  remove|rm) shift; cmd_remove "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
